# API
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solupaes?schema=public"

# JWT — gere com `openssl rand -base64 64`
JWT_SECRET="change-me-32-bytes-or-more-please-replace-in-production"
JWT_ACCESS_TTL=15m
REFRESH_SECRET="change-me-refresh-token-secret-replace-in-production"
JWT_REFRESH_TTL=7d

# CORS — origens permitidas (vírgulas)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8081"

# Cloudflare R2 (S3-compatível)
R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="solupaes-prod"
R2_PUBLIC_URL=""

# IA estratégica (opcional)
ENABLE_AI_STRATEGY=false
GEMINI_API_KEY=""

# Observabilidade
SENTRY_DSN=""

# Senha dos usuários criados pelo seed de desenvolvimento.
# Defina o valor que quiser usar para logar em dev. Não comite este arquivo.
SEED_PASSWORD=""
