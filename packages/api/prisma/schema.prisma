generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTOR
  REPRESENTANTE
}

enum Classification {
  A
  B
  C
}

enum VisitStatus {
  SYNCED
  PENDING_REVIEW
  ARCHIVED
}

enum StrategyType {
  EQUIPMENT_OFFER
  PRICE_DIFFERENTIATION
  BONIFICATION
  PRODUCT_DEMO
  RELATIONSHIP_FOLLOWUP
  INSTITUTIONAL_PITCH
}

enum StrategyStatus {
  PROPOSED
  IN_PROGRESS
  WON
  LOST
  POSTPONED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role
  active           Boolean    @default(true)
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  visits           Visit[]
  strategiesCreated Strategy[] @relation("StrategyCreator")

  @@index([active])
}

model Client {
  id              String     @id @default(cuid())
  fantasyName     String
  socialReason    String?
  cnpj            String?
  phone           String?
  whatsapp        String?
  addressLine     String
  city            String?
  state           String?
  lat             Float?
  lng             Float?
  worksWithFrozen Boolean    @default(false)
  currentSupplier String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  visits          Visit[]
  strategies      Strategy[]

  @@index([lat, lng])
  @@index([fantasyName])
}

model Visit {
  id               String         @id @default(cuid())
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id])
  representativeId String
  representative   User           @relation(fields: [representativeId], references: [id])
  fantasyName      String
  phone            String?
  addressLine      String
  lat              Float?
  lng              Float?
  facadePhotoKey   String?
  worksWithFrozen  Boolean
  currentSupplier  String?
  dailyVolume      Float?
  currentPrice     Float?
  equipmentLent    String[]
  observations     String?
  viabilityScore   Int
  classification   Classification
  status           VisitStatus    @default(SYNCED)
  clientUuid       String         @unique
  visitedAt        DateTime
  syncedAt         DateTime       @default(now())

  strategies       Strategy[]

  @@index([visitedAt])
  @@index([representativeId])
  @@index([classification])
  @@index([clientId])
}

model Strategy {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  visitId       String?
  visit         Visit?          @relation(fields: [visitId], references: [id])
  title         String
  description   String
  type          StrategyType
  status        StrategyStatus  @default(PROPOSED)
  followUpAt    DateTime?
  createdById   String
  createdBy     User            @relation("StrategyCreator", fields: [createdById], references: [id])
  generatedByAi Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, followUpAt])
  @@index([clientId])
  @@index([createdById])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, action])
}
